rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the current request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the request is for the user's own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the requesting user has an admin role in the database
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for the users collection
    match /users/{userId} {
      // Any authenticated user can read their own profile, or admins can read any profile
      allow read: if isOwner(userId) || isAdmin();
      
      // Creating a new user: they can write only their own document if they set their role as 'user', OR if they are an admin
      allow create: if isOwner(userId) && (request.resource.data.role == 'user' || isAdmin());
      
      // Updating a user: they can only update their own profile, but they cannot change their role unless they are already an admin
      allow update: if isOwner(userId) && (request.resource.data.role == resource.data.role || isAdmin()) || isAdmin();
      
      // Deleting a user: only admins can delete users
      allow delete: if isAdmin();
    }
  }
}
